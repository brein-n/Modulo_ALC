#genera un "circulo" de 1m de radio con centro en (x,y), se genera con 8 puntos(el 9 cierra el circulo)
def circulo(x,y):
    c=[]
    c.append((x+1, y))
    c.append((x+0.7, y+0.7))
    c.append((x, y+1))
    c.append((x-0.7, y+0.7))
    c.append((x-1, y))
    c.append((x-0.7, y-0.7))
    c.append((x, y-1))
    c.append((x+0.7, y-0.7))
    c.append((x+1, y))
    return c

#guardamos coordenadas de los circulos de cada jugador en el plano
